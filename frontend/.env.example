
# VeriVision product app / console: environment template.
#
#   cp .env.example .env.local
#
# WARNING: this app does NOT use the same variable names as the marketing site
# in verisec-web/. The marketing site reads NEXT_PUBLIC_API_BASE_URL; this app
# reads NEXT_PUBLIC_API_BASE (no _URL suffix). Copying an env file between the
# two folders silently does nothing, because each ignores the other's names.
#
# Never put a secret in any NEXT_PUBLIC_ variable. They are inlined into the
# JavaScript bundle and readable in view-source.


# ---------------------------------------------------------------------------
# Backend locations (read in the browser)
# ---------------------------------------------------------------------------

# Recognition gateway. src/lib/api.ts falls back to "" when unset, which means
# requests go to this app's own origin. That works in `next dev` and in a
# standalone build, because next.config.ts proxies /api/* to BACKEND_URL below.
# It does NOT work in a static export, which has no server and therefore no
# proxy, so set this explicitly for any export build.
NEXT_PUBLIC_API_BASE=https://api.verivision.mmose.tech

# Document-liveness gateway (KBY-AI idl). Separate host from the one above.
# src/lib/api.ts already defaults to this exact value, so you only need to set
# it when pointing at a different liveness host.
NEXT_PUBLIC_LIVENESS_BASE=https://apiv2.verivision.mmose.tech


# ---------------------------------------------------------------------------
# Dev proxy target (server-side, never sent to the browser)
# ---------------------------------------------------------------------------

# next.config.ts rewrites /api/*, /health, /docs and /openapi.json to this host
# during `next dev` and in a standalone build. Defaults to http://localhost:8000
# when unset. Ignored entirely in a static export, which has no server.
BACKEND_URL=http://127.0.0.1:8081


# ---------------------------------------------------------------------------
# Build mode (set per build, not in .env.local)
# ---------------------------------------------------------------------------
# Leave both unset for normal `next dev` and `next build`.
#
#   NEXT_EXPORT=1                 static export to out/, for Namecheap cPanel.
#                                 No server, so no proxy: NEXT_PUBLIC_API_BASE
#                                 above must be set, or the app has no backend.
#   NEXT_BUILD_TARGET=standalone  self-contained Node server output (Docker).
#
# Note this app also carries public/config.js, a runtime backend switch read at
# page load. It needs no rebuild to change hosts, which is why the static export
# can ship without these variables baked in. Two mechanisms overlap here: prefer
# public/config.js for the deployed static build, and these variables for dev.

# VeriSec Labs marketing site: environment reference.
#
# You normally do NOT need to copy this anywhere. Working values are already
# committed and picked automatically by the command you run:
#
#   pnpm dev     reads .env.development   ->  http://localhost:3100
#   pnpm build   reads .env.production    ->  the live domain
#
# Those two files never override each other, so a dev value cannot leak into a
# production build. Edit whichever matches the environment you mean.
#
# Only create .env.local for a personal, machine-specific override, and expect
# it to apply to BOTH dev and build (it outranks both files above). That is why
# the dev values do not live there.
#
# READ THIS FIRST
# This site is a static export (`output: "export"` in next.config.ts). There is
# no server at runtime, so every value below is baked into the HTML/JS at BUILD
# time. Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and
# is readable by anyone who views source.
#
# Therefore: never put a secret, API key, JWT signing key, database URL or SMTP
# password in this file. Those belong to the backend only. If a value must stay
# private, it cannot live in this project at all.


# Canonical public origin of the site, no trailing slash.
#
# Used by src/config/seo.ts to build metadataBase, the per-page canonical URLs,
# sitemap.xml, robots.txt and the OpenGraph image URL. If this is wrong or unset
# in a production build, canonicals and social previews resolve against the
# fallback origin instead of the real one, which quietly breaks link previews
# and confuses search engines.
NEXT_PUBLIC_SITE_URL=https://verisec.dev


# Base URL of the VeriVision FastAPI backend, no trailing slash.
#
# Used by src/lib/api.ts for the login and signup forms. Empty means requests go
# to the site's own origin, which has no API, so auth submits will fail. Set it
# to the backend origin for the environment you are building against.
#
# The backend must allow this site's origin in its CORS config, or the browser
# blocks the request before it reaches the API.
NEXT_PUBLIC_API_BASE_URL=https://api.verisec.dev
NEXT_PUBLIC_AUTH_API=https://api.verisec.dev
NEXT_PUBLIC_AUTH_GATE=1

# VeriSec Investigator (agentic review): server-side LLM via OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INVESTIGATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NEXT_PUBLIC_INVESTIGATOR_URL=http://localhost:8799
