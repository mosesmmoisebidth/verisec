# --- secrets / env ---
.env
*.env.local

# --- Go (gateway) ---
services/gateway/gateway
services/gateway/*.exe
/tmp/

# --- Node / NestJS (console) ---
node_modules/
dist/
.npm/
*.tsbuildinfo

# --- Python (workers) ---
.venv/
venv/
__pycache__/
*.pyc

# --- infra / docker ---
infra/**/data/
infra/**/volumes/

# OpenBao: unseal key + root token (never commit)
infra/openbao/init.json
infra/openbao/*.secret

# mTLS client identity (private key!) - never commit
infra/pki/
