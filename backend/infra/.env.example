DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432
PGHOST_FROM_CONTAINER=host.docker.internal
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
EMAIL_FROM_NAME=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=STARTTLS
ZITADEL_MASTERKEY=GENERATE_32_CHARS
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
# Optional public-facing Zitadel URL for SAML metadata when it differs from the external domain/port above.
ZITADEL_PUBLIC_URL=

# Browser console authentication. These are public origins, not secrets.
# For local secure development, APP_URL=https://localhost:3000 and
# CONSOLE_PUBLIC_URL=https://localhost:3001. In production set APP_URL to the
# frontend origin and CONSOLE_PUBLIC_URL to the public HTTPS origin serving this
# console API; it must be reachable for Zitadel SSO and Google callbacks.
APP_URL=https://localhost:3000
CONSOLE_PUBLIC_URL=https://localhost:3001
CONSOLE_CORS_ORIGINS=http://localhost:3100,https://localhost:3000
CONSOLE_AUTH_GATE=1
COOKIE_SECURE=true
ZITADEL_ADMIN_USER=admin@verisec.localhost
ZITADEL_ADMIN_PASSWORD=CHANGE_ME
